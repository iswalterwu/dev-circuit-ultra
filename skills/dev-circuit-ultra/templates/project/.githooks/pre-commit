#!/bin/sh
# python3 on macOS/Linux, python on Windows and in most CI images
command -v python3 >/dev/null 2>&1 && PY=python3 || PY=python
"$PY" scripts/doc_guard.py || { echo "doc_guard 未通过：文档里出现了记账内容、历史目录或断链。"; exit 1; }
"$PY" scripts/spec_check.py || { echo "spec_check 未通过：能力规格的代号或编号有误，或者代码、测试引用了不存在的编号。"; exit 1; }
