{
  "name": "dev-circuit-ultra",
  "version": "0.4.0",
  "description": "Less context. Less ceremony. More shipping. A design-first five-step loop for coding agents.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "assets",
    "!assets/demo-60s-*.mp4",
    "!assets/demo-60s-*.webm",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "demo",
    "docker",
    "docs/dsh.md",
    "hooks",
    "tools",
    "pyproject.toml",
    "docs/ledger.md",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "sync.ps1"
  ],
  "keywords": [
    "pi-package",
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "claude-code",
    "codex",
    "spec-driven-development",
    "design",
    "code-review"
  ],
  "author": "iswalterwu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iswalterwu/dev-circuit-ultra.git"
  },
  "homepage": "https://github.com/iswalterwu/dev-circuit-ultra",
  "bugs": {
    "url": "https://github.com/iswalterwu/dev-circuit-ultra/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "python -m pytest -q",
    "demo": "python demo/run_demo.py"
  }
}
